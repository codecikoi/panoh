# --- Telegram ---
BOT_TOKEN=123456:ABC-DEF              # from @BotFather
BOT_MODE=polling                      # polling (local dev) | webhook (production)
WEBHOOK_URL=https://bot.example.com/telegram/webhook
WEBHOOK_SECRET=change-me              # any random string; Telegram sends it back in a header
TELEGRAM_PROXY=                       # optional http(s)://user:pass@host:port if api.telegram.org is blocked
INTERNAL_TOKEN=change-me-too          # protects POST /internal/tick (external cron on scale-to-zero hosts)

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
AI_EXTRACT_MODEL=claude-haiku-5-5     # parses every marked message (cheap)
AI_INSIGHTS_MODEL=claude-opus-5-5     # writes summary insights and tips
AI_TIMEOUT_MS=30000

# --- Database ---
# Leave DATABASE_URL empty to use an embedded PGlite database in ./data/pglite (local dev only).
DATABASE_URL=
# DATABASE_URL=postgres://user:pass@host:5432/budgie
PGLITE_DIR=./data/pglite

# --- Defaults for new households (overridden per language when the user's Telegram language is known) ---
DEFAULT_LOCALE=en
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC

# --- Dashboard (stage 2) ---
DASHBOARD_URL=                        # https page of the Mini App (web_app button in private chats)
DASHBOARD_TME_LINK=                   # https://t.me/<bot>/<app> direct link (button in groups)
DASHBOARD_ORIGIN=                     # CORS origin for the API

PORT=8080
LOG_LEVEL=info
